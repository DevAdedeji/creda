# Keep this secret in .env only. Use at least 32 random characters.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4002

# Local PostgreSQL from docker compose. For Neon, use its PostgreSQL URLs.
DATABASE_URL=postgres://creda:creda@localhost:5444/creda
# Optional direct URL for migrations when DATABASE_URL is a pooled Neon URL.
DIRECT_URL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional browser key for Places suggestions and free Maps embeds. Enable billing, Maps JavaScript API, Places API (New), and Maps Embed API. Restrict the key to your site and these APIs.
NUXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Production email delivery through Resend. Local dev logs links instead.
RESEND_API_KEY=
AUTH_EMAIL_FROM=Creda <hello@your-domain.com>

# Comma-separated verified account emails allowed to moderate reviews and verify ownership.
CREDA_ADMIN_EMAILS=

# Server-only Byteship project key with files:write and files:delete access for business photos.
CREDA_BYTESHIP_API_KEY=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
ASK_CREDA_DAILY_USER_LIMIT=20
ASK_CREDA_DAILY_LIMIT=200
